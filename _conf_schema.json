{
  "subscription_sources": {
    "type": "template_list",
    "description": "订阅源",
    "templates": {
      "source": {
        "name": "订阅源",
        "display_item": "name",
        "items": {
          "name": {"type": "string", "description": "来源名称", "default": "source"},
          "source_type": {"type": "string", "description": "remote 或 local", "default": "remote"},
          "url": {"type": "string", "description": "远程 URL", "default": ""},
          "file_path": {"type": "string", "description": "本地文件路径；绝对路径直接使用，相对路径相对于插件目录（例如 sub/Easycloud.yaml）", "default": ""},
          "content": {"type": "string", "description": "本地或上传内容", "default": ""},
          "user_agent": {"type": "string", "description": "单源 User-Agent", "default": ""},
          "notify_changes": {"type": "bool", "description": "是否推送此源的详细节点变化名称", "default": true},
          "include_regex": {"type": "string", "description": "包含节点：节点名称匹配此正则时保留，留空表示不限制", "default": ""},
          "exclude_regex": {"type": "string", "description": "排除节点：节点名称匹配此正则时移除，优先于包含规则", "default": ""},
          "node_list_output": {"type": "bool", "description": "是否将此源中的原始分享链接额外输出为 Node List", "default": false},
          "filter_invalid_nodes": {"type": "bool", "description": "是否跳过缺少必要字段、Reality 参数非法或分享链接适配失败的节点", "default": false},
          "priority": {"type": "int", "description": "优先级", "default": 100},
          "enabled": {"type": "bool", "description": "启用", "default": true}
        }
      }
    },
    "default": []
  },
  "user_agent": {"type": "string", "description": "全局 User-Agent", "default": "clash-verge"},
  "rule_profile": {"type": "string", "description": "Mihomo DNS 与规则 profile：metacubex 或 minimal", "default": "metacubex"},
  "singbox_tun_enable": {"type": "bool", "description": "sing-box 输出是否启用纯 TUN；关闭后不生成任何入站", "default": true},
  "request_timeout_seconds": {"type": "int", "description": "请求超时", "default": 20},
  "runtime_dir": {"type": "string", "description": "持久化运行目录", "default": ""},
  "http_enable": {"type": "bool", "description": "启用订阅 HTTP", "default": true},
  "http_host": {"type": "string", "description": "监听地址", "default": "127.0.0.1"},
  "http_port": {"type": "int", "description": "监听端口", "default": 8077},
  "public_base_url": {"type": "string", "description": "公网订阅基础地址", "default": "https://sub.tomori.cloud"},
  "access_token": {"type": "string", "description": "订阅 URL 访问 token；留空仅首次自动生成", "default": ""},
  "refresh_interval_minutes": {"type": "int", "description": "刷新间隔", "default": 180},
  "startup_push": {"type": "bool", "description": "启动刷新后通知绑定会话", "default": false},
  "notify_on_error": {"type": "bool", "description": "定时刷新失败时通知", "default": true},
  "notify_targets": {"type": "list", "description": "通知会话，由 /subagg bind 写入", "default": []},
  "local_sources_dir": {"type": "string", "description": "本地文件订阅目录，默认使用运行目录/local_sources", "default": ""}
}
